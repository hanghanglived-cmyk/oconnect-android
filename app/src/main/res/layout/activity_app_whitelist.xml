<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/colorSurface">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIconTint="?attr/colorOnSurface" app:titleTextColor="?attr/colorOnSurface" />
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/whitelist_enabled" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:minHeight="56dp" android:text="@string/whitelist_enable" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:text="@string/whitelist_explanation"
        android:textColor="?attr/colorOnSurfaceVariant" />
    <TextView android:id="@+id/whitelist_count" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_margin="16dp"
        android:accessibilityLiveRegion="polite" android:textColor="?attr/colorOnSurface" />
    <EditText android:id="@+id/whitelist_search" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:minHeight="48dp" android:hint="@string/whitelist_search"
        android:inputType="text" android:singleLine="true" android:importantForAutofill="no" />
    <TextView android:id="@+id/whitelist_loading" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="16dp"
        android:text="@string/whitelist_loading" android:textColor="?attr/colorOnSurfaceVariant" />
    <ListView android:id="@+id/whitelist_apps" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false"
        android:paddingStart="8dp" android:paddingEnd="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="16dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            style="?attr/materialButtonOutlinedStyle" android:id="@+id/whitelist_clear"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/whitelist_clear" />
        <com.google.android.material.button.MaterialButton android:id="@+id/whitelist_save"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:text="@string/save" android:enabled="false" />
    </LinearLayout>
</LinearLayout>
